@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@{
    var root = Model.Root();
    var commonComponent = root.Children().FirstOrDefault(x => x.ContentType.Alias == "commonComponents");
    var mainNavigation = commonComponent?.Value<IEnumerable<Link>>("mainNavigation");
    var stickyNavigation = commonComponent?.Value<BlockListModel>("stickyNavigation");
    var callToAction = commonComponent?.Value<Umbraco.Cms.Core.Models.Link>("callToAction");
}

<nav class="navbar navbar-expand-lg fixed-top py-3 header-nav blur-reveal shadow-sm">
    <div class="container-fluid px-2 px-md-5">

        <a class="navbar-brand d-flex align-items-center" href="/">
       
           <img src="/assets/img/Logo_Consistec.svg"
         alt="Consistec" class="logo">
        </a>

        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav gap-2 gap-lg-3 align-items-lg-center mt-lg-0">
                    @await Html.GetBlockListHtmlAsync(commonComponent.Value<BlockListModel>("mainNavigationWithDropdown"))
                </ul>
            

        </div>
        <div class="col-auto col-lg-2 text-end lg-ps-0 xs-pe-0 ms-4 d-flex align-items-center justify-content-end">
        @if (callToAction != null ){
                <div class="header-icon d-flex align-items-center">
                    <div class="header-button">
                        <a href="@callToAction.Url" target="@callToAction.Target" class="btn btn-large btn-gradient-pink-orange d-table d-lg-inline-block 
 md-mx-auto px-3 py-3 rounded-0 fw-normal shadow-sm transition text-white">
                            <span>
                                <span class="btn-double-text">@Html.Raw(callToAction.Name)</span>
                                <span><i class="bi bi-arrow-right-circle-fill"></i></span>
                            </span> 
                        </a> 
                    </div>
                </div>
            }
        </div>
    </div>
</nav>

@if (stickyNavigation != null)
{
    var items = stickyNavigation.ToList();

    foreach (var link in items.Take(1))
    {
        <div class="buy-theme alt-font">
            <a href="@link.Content.Value("menuLink")" target="_blank">
                <i class="bi @link.Content.Value("iconCssClass")"></i>
                <span>@link.Content.Value("menuTitle")</span>
            </a>
        </div>
    }

    foreach (var link in items.Skip(1).Take(1))
    {
        <div class="call alt-font">
            <a href="@link.Content.Value("menuLink")">
                <i class="bi @link.Content.Value("iconCssClass")"></i>
                <span>@link.Content.Value("menuTitle")</span>
            </a>
        </div>
    }
}
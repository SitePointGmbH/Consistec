@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using System.Text.Json
@using Umbraco.Cms.Core.Models.Blocks;

<div class="benefits-pin-container bg-light" id="benefits-pin-container" style="background-color:#e3ecf1 !important">
    <section class="benefits-section py-5 d-flex align-items-center" id="benefits-section">
        <div class="container w-100">
            <div class="row justify-content-center mb-5">
                <div class="col-lg-10 text-center">
                    <h2 class="mb-4">@Model.Value("goodAnswerHeading")</h2>
                    <p class="fs-5 text-dark mb-0 fancy-text-style-4">@Model.Value("goodAnswerSubheading")</p>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-9">
                    @{
                        IEnumerable<BlockListItem> blocks = null;
                        try {
                            blocks = Model.Value<IEnumerable<BlockListItem>>("answers");
                        } catch (Exception) {
                            // Gracefully ignore invalid or deleted block types
                        }
                    }
                    @if (blocks != null && blocks.Any())
                    {
                        <div class="benefits-list py-2">
                            @{
                                int index = 0;
                            }
                            @foreach (var block in blocks)
                            {
                                var aosDirection = index % 2 == 0 ? "fade-right" : "fade-left";

                                <div class="benefit-item mb-3" data-aos="@aosDirection">
                                    <p class="fs-5 mb-0">
                                        @Html.Raw(block.Content.Value("textContent")?.ToString() .Replace("<p>", "").Replace("</p>", ""))
                                    </p>
                                </div>
                                index++;
                            }
                        </div>
                    }
                    @{
                        var ctaButton = Model.Value<Link>("goodAnswerC2A");                     
                        @if (ctaButton != null)
                        {
                            <div class="text-center mt-3 benefit-item" data-step="5">
                                <a href="@ctaButton.Url"
                                       target="@ctaButton.Target"
                                       class="btn btn-large btn-gradient-pink-orange d-table d-lg-inline-block xl-mb-15px md-mx-auto px-5 py-3 rounded-0 fw-normal shadow-sm transition text-white">
                                    @ctaButton.Name
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using System.Text.Json
@using Umbraco.Cms.Core.Models.Blocks;

@{
    var parallaxBackgroundImage = Model.Value<IPublishedContent>("parallaxBackgroundImage");
    var dynamicVideos = Model.Value<IEnumerable<BlockListItem>>("videoGallery");
    var videoIndex = 0;
}

<section id="ecotel-section" class="ecotel-fullwidth-section"
         style="background-image: url('@parallaxBackgroundImage?.Url()');">
    <div class="container">
        <div class="row g-0 align-items-center">

            <!-- Left Side Video Slider -->
            <div class="col-lg-6 p-0">

                <div class="position-relative">

                    <div id="videoSlider" class="carousel slide" data-bs-ride="false">

                        <div class="carousel-inner">

                            @if (dynamicVideos != null && dynamicVideos.Any())
                            {
                                foreach (var item in dynamicVideos)
                                {
                                    videoIndex++;

                                    var posterVideo = item.Content.Value<IPublishedContent>("uploadVideo");
                                    var posterImage = item.Content.Value<IPublishedContent>("posterImage");

                                    <div class="carousel-item @(videoIndex == 1 ? "active" : "") position-relative"
                                         style="height:450px; cursor:pointer;">

                                        @if (posterVideo != null)
                                        {
                                            <video class="ecotel-video w-100 h-100 object-fit-cover position-absolute top-0 start-0"
                                                   src="@posterVideo.Url()"
                                                   poster="@posterImage?.Url()"
                                                   loop
                                                   muted
                                                   playsinline>
                                            </video>
                                        }

                                        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>

                                        <div class="position-absolute top-50 start-50 translate-middle text-center text-white z-2">
                                            <h3 class="mb-1 fw-normal display-6">Animation oder Grafiken</h3>
                                            <p class="mb-0 fs-5">(Video / Interaction)</p>
                                        </div>

                                        <button type="button"
                                                class="ecotel-play-btn position-absolute top-50 start-50 translate-middle btn rounded-circle border border-3 border-white text-white z-3 d-flex align-items-center justify-content-center pe-none"
                                                style="width:70px;height:70px;background-color:rgba(0,0,0,.35);">
                                            <i class="bi bi-play-fill fs-1"></i>
                                        </button>

                                    </div>
                                }
                            }

                        </div>

                        <button class="carousel-control-prev" type="button"
                                data-bs-target="#videoSlider"
                                data-bs-slide="prev">
                            <span class="carousel-control-prev-icon p-4 bg-dark bg-opacity-50"></span>
                        </button>

                        <button class="carousel-control-next" type="button"
                                data-bs-target="#videoSlider"
                                data-bs-slide="next">
                            <span class="carousel-control-next-icon p-4 bg-dark bg-opacity-50"></span>
                        </button>

                        <div class="position-absolute bottom-0 end-0 text-white fs-5 z-3 p-3">
                            <span id="currentVideoSlide">1</span> / @dynamicVideos.Count()
                        </div>

                    </div>

                </div>

            </div>

            <!-- Right Side Text -->
            <div class="col-lg-6">
                <div class="ecotel-text-panel">
                    <h2 class="display-6 fw-bold mb-4 text-white">
                        @Model.Value("parallaxHeading")
                    </h2>

                    <div class="quote-mockup fs-6 text-white border-start border-danger border-3 ps-4 lh-lg py-1">
                        @Model.Value("parallaxContent")
                    </div>
                </div>
            </div>

        </div>
    </div>
   
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const slider = document.getElementById("videoSlider");
        const currentSlide = document.getElementById("currentVideoSlide");

        function setIcon(item, iconClass) {
            const btn = item.querySelector(".ecotel-play-btn");
            const icon = btn.querySelector("i");

            icon.classList.remove("bi-play-fill", "bi-pause-fill");
            icon.classList.add(iconClass);
            btn.classList.remove("d-none");
        }

        function hideIcon(item) {
            item.querySelector(".ecotel-play-btn").classList.add("d-none");
        }

        slider.querySelectorAll(".carousel-item").forEach(item => {

            item.addEventListener("click", function (e) {

                if (e.target.closest(".carousel-control-prev") || e.target.closest(".carousel-control-next")) {
                    return;
                }

                const video = this.querySelector("video");

                if (video.paused) {
                    video.play();
                    hideIcon(this);
                } else {
                    video.pause();
                    setIcon(this, "bi-pause-fill");
                }

            });

        });

        slider.addEventListener("slid.bs.carousel", function (e) {

            currentSlide.textContent = e.to + 1;

            slider.querySelectorAll(".carousel-item").forEach(item => {
                const video = item.querySelector("video");

                video.pause();
                video.currentTime = 0;
                setIcon(item, "bi-play-fill");
            });

        });

    });
</script>
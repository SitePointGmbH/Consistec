@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<TextBlock,GridContentSetting>>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var buttonLink = Model.Content.Value<Umbraco.Cms.Core.Models.Link>("ctaButton");
}

<div class="px-3 px-md-0">
<div class="rich-text @Model.Settings?.CustomCssClass" style="text-align:@Model.Settings?.Alignment">@Model.Content.TextContent
    @if (buttonLink != null)
    {
        <a href="@buttonLink.Url"
           target="@buttonLink.Target"
           class="btn btn-large btn-gradient-pink-orange text-white rounded-0">
            @buttonLink.Name
        </a>
    }
</div>
</div>
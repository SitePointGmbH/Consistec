@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using System.Text.Json
@using Umbraco.Cms.Core.Models.Blocks;

@if (Model.HasValue("bannerTextLines", fallback: Fallback.ToLanguage))
{
    var bg = Model.Value<IPublishedContent>("bannerImage", fallback: Fallback.ToLanguage);
    var bannerTextLines = Model.Value<IEnumerable<string>>("bannerTextLines", fallback: Fallback.ToLanguage);
    <section id="home"
    class="hero-section d-flex align-items-end position-relative min-vh-100 bg-light border-bottom" style="min-height: 75vh !important">
        <!-- Hero Background Carousel -->
        <div class="hero-bg-carousel">
            <div class="hero-bg-slide active" style="background-image: url('@bg?.Url()'); background-size:cover"></div>
        </div>
        <div class="container px-4 px-md-5 mt-5">
            <div class="row align-items-end">
                <div class="col-md-8 offset-md-4 align-self-end">

                    <div class="hero-rotator-container mb-2">

                        <h1 class="display-4 text-dark fancy-text-style-4 mb-1 pb-1" style="line-height: 1.15;font-size:40px">Cybersicherheit beginnt mit Sichtbarkeit.</h1>
                        <h1 class="display-4  text-dark fancy-text-style-4 mb-0 pb-0"
                        style="line-height: 1.15;font-size:40px;min-height:50px">

                            <span data-fancy-text='{
                            "effect": "rotate",
                            "direction": "up",
                            "speed": 40,
                            "duration": 4500,
                            "string": [
                                @Html.Raw(string.Join(",", bannerTextLines.Select(x => $"\"{x}\"")))
                            ]
                            }'>
                            </span>

                        </h1>

                    </div>

                </div>
            </div>
        </div>
    </section>

}
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using System.Text.Json
@using Umbraco.Cms.Core.Models.Blocks;
@{
    var bgImage = Model.Value<IPublishedContent>("backgroundImage")?.Url();
    var fullwidthStack = (Model.Value<bool>("useFullWidth")) ? "" : "container";
    var imageDesktopUrl = (Model.HasValue("imageDesktop")) ? Model.Value<IPublishedContent>("imageDesktop")?.GetCropUrl(width: 2200, furtherOptions: "&format=webp") : "";
    var imageMobileUrl = (Model.HasValue("imageMobile")) ? Model.Value<IPublishedContent>("imageMobile")?.GetCropUrl(width: 768, furtherOptions: "&format=webp") : "";
}

<section class="regular-section pb-0 mb-0" style="background-size:cover; background-image: url(@bgImage)">
    <div class="container">
        <div class="row g-5 align-items-start mb-5">
            <div class="col-12">
                <h2 class="display-5">@Model.Value("stackTitle")</h2>
                @Model.Value("introText")
            </div>
            <div class="col-lg-5">
                <div class="industry-grid-mockup">
                    @Html.Raw(Model.Value("leftSideContent")?.ToString().Replace("<p>", "").Replace("</p>", ""))
                </div>
            </div>
            <div class="col-lg-7">
                <div class="ps-lg-5">
                    <div>
                        @Model.Value("rightSideContent")
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


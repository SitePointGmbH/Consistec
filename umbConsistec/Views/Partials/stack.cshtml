*@

<div class="stacking-wrapper py-1" id="third-section">
    <section class="p-section stack-section sec-intro step-section" id="p-sec-2">
        <div class="container">
            <div class="accordion-single">
                <div class="accordion-header d-flex align-items-center justify-content-between"
                     role="button"
                     onclick="toggleAccordion(this)">
                   
            <span class="fw-700 fs-22 text-white d-flex align-items-center justify-content-center">
                <span class="h-50px w-50px border border-color-transparent-dark-very-light fs-15 fw-500 d-flex
 align-items-center justify-content-center border-radius-100 me-2">01</span>
                <div class="d-flex flex-column">
                <div>@Umbraco.GetDictionaryValue("Datenquellen")</div>
                <small class="ms-2 d-block fs-12">@Model.Value("smallTextStack1")</small>
                </div>
            </span>
                    
                    <i class="bi bi-chevron-down accordion-icon"></i>
                </div>
                <div class="accordion-body">
                    <div class=" p-5">
                        @Model.Value("introtextStack1")
                    </div>
                </div>
            </div>

            <div class="row justify-content-center text-center gx-lg-5">
                @{
                    var dataSources = Model.Value<BlockListModel>("dataSources");
                    if (dataSources != null)
                    {
                        int index = 0;
                        foreach (var block in dataSources)
                        {
                            var content = block.Content;
                            var heading = content.Value<string>("title");
                            var image = content.Value<IPublishedContent>("image");
                            var binaryText = content.Value<string>("binaryText");
                            var hasPurpleBox = index < 3;

                            <div class="col-lg-4 col-md-4 col-10 text-white mt-5">
                                <div class="d-flex flex-column align-items-center border border-white">
                                    <h2 class="my-5 mt-sm-0 mb-5 flow-heading">@Html.Raw(heading?.Replace("\n", "<br>"))</h2>

                                    <div class="@(hasPurpleBox ? "purple-box" : "") d-flex align-items-center justify-content-center">

                                        @if (image != null)
                                        {
                                            <img src="@image.Url()" alt="@heading" class="@(!hasPurpleBox ? "rounded-3" : "") img-fluid max-h-100" style="max-height:100%"/>
                                        }
                                        else if (block.Content.HasValue("binaryText"))
                                        {
                                            <div class="text-white small lh-lg text-center" style="color:#50248c !important;">
                                                @Html.Raw(block.Content.Value("binaryText")?.ToString().Replace("<p>", "").Replace("</p>", "")
                                                )
                                            </div>
                                        }

                                    </div>

                                </div>
                                <div class="arrow"></div>
                            </div>
                            index++;
                        }
                    }
                }
            </div>
        </div>
    </section>

    <section class="step2-section p-section stack-section sec-event bg-white" id="p-sec-3">
        <div class="container">
            <div class="accordion-single">
                <div class="accordion-header d-flex align-items-center justify-content-between"
                     role="button"
                     onclick="toggleAccordion(this)">
                   
                    <span class="fw-700 fs-22 text-white d-flex align-items-center justify-content-center">
                        <span class="h-50px w-50px border border-color-transparent-dark-very-light fs-15 fw-500 d-flex
 align-items-center justify-content-center border-radius-100 me-2">02</span>
                        <div class="d-flex flex-column">
                            <div> @Umbraco.GetDictionaryValue("Event-Layer")</div>
                            <small class="ms-2 d-block fs-12">@Model.Value("smallTextStack2")</small>
                        </div>
                    </span>

                    <i class="bi bi-chevron-down accordion-icon white text-white"></i>
                </div>
                <div class="accordion-body">
                    <div class="p-5 text-white">
                        @Model.Value("introtextStack2")
                    </div>
                </div>
            </div>
            
           
            <div class="row justify-content-center text-center gy-5 gx-xl-5 mt-1">
                @{
                    var securityAnalyticsLayers = Model.Value<BlockListModel>("securityAnalyticsLayers");
                    if (securityAnalyticsLayers != null)
                    {
                        foreach (var block in securityAnalyticsLayers)
                        {
                            var content = block.Content;
                            var title = content.Value<string>("title");
                            var description = content.Value<string>("description");
                            var image = content.Value<IPublishedContent>("image");

                            <div class="col-xl col-lg-3 col-md-3 col-10">
                                <div class="analysis-item">
                                    <div class="analysis-title my-5 my-sm-0">
                                        @Html.Raw(title?.Replace("\n", "<br>"))
                                    </div>
                                    <div class="analysis-box">
                                        @if (image != null)
                                        {
                                            <img src="@image.Url()" alt="@title" class="ai-icon">
                                        }
                                        else if (!string.IsNullOrWhiteSpace(description))
                                        {
                                            <div class="analysis-text">
                                                @Html.Raw(description.Replace("\n", "<br>"))
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
            <div class="big-arrow-wrap">
                <div class="big-arrow"></div>
            </div>
        </div>

    </section>

    <section class="step3-section p-section stack-section sec-analysis" id="p-sec-4">
        <div class="container">
            <div class="accordion-single">
                <div class="accordion-header d-flex align-items-center justify-content-between"
                     role="button"
                     onclick="toggleAccordion(this)">
                   
                    <span class="fw-700 fs-22 text-white d-flex align-items-center justify-content-center">
                        <span class="h-50px w-50px border border-color-transparent-dark-very-light fs-15 fw-500 d-flex
 align-items-center justify-content-center border-radius-100 me-2">03</span>
                        <div class="d-flex flex-column">
                            <div> @Umbraco.GetDictionaryValue("Nutzen")</div>
                            <small class="ms-2 d-block fs-12">@Model.Value("smallTextStack3")</small>
                        </div>
                    </span>

                    <i class="bi bi-chevron-down accordion-icon text-white white"></i>
                </div>
                <div class="accordion-body">
                    <div class="p-5 text-white">
                        @Model.Value("introtextStack3")
                    </div>
                </div>
            </div>


            <div class="text-center pt-5">
                <div class="row justify-content-center text-center gy-5">
                    @{
                        var keyBenefits = Model.Value<IEnumerable<string>>("keyBenefits");
                        if (keyBenefits != null && keyBenefits.Any())
                        {
                            foreach (var benefit in keyBenefits)
                            {
                                <div class="col-xl col-lg-4 col-md-6">
                                    <div class="benefit-card">
                                        <div class="benefit-box">
                                            <div class="check-icon">
                                                <img src="/assets/img/Vector 21.svg" alt="Check">
                                            </div>
                                            <div class="benefit-text">
                                                @Html.Raw(benefit?.Replace("\n", "<br>"))
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </section>
</div>